---
import ArrowRight from './icons/ArrowRight.astro';
---

<section class="hero-section relative overflow-hidden bg-linear-to-br from-soft-lavender via-off-white to-lavender/40">
	<div class="pointer-events-none absolute inset-y-0 left-0 w-44 celestial-night opacity-60 lg:w-60"></div>
	<div class="pointer-events-none absolute inset-y-0 right-0 w-36 celestial-surface opacity-50 lg:w-52"></div>

	<div
		class="relative mx-auto grid max-w-360 items-center gap-10 px-6 py-16 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-12 lg:px-10 lg:py-20 xl:py-24"
	>
		<div class="relative z-10 max-w-xl">
			<h1 class="font-display text-[2.75rem] leading-[1.1] font-semibold text-navy-blue lg:text-5xl xl:text-[3.35rem]">
				Unforgettable Dessert Experiences
			</h1>
			<p class="font-display mt-3 text-2xl leading-snug text-primary-purple lg:text-[1.75rem]">
				for Baltimore's Most Memorable Events
			</p>
			<p class="mt-6 max-w-md text-base leading-relaxed text-navy-blue/80 lg:text-lg">
				Where cosmic creativity meets flawless execution — custom dessert tables, wedding cakes, and branded treats
				designed to impress and delivered with precision.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a
					href="/contact/"
					class="btn btn-primary btn-lg shadow-glow gap-2 px-7"
				>
					Plan Your Event <ArrowRight class="h-4 w-4" />
				</a>
				<a
					href="/order/"
					class="btn btn-lg border-0 bg-lavender text-primary-purple hover:bg-soft-lavender px-7"
				>
					Browse Menu
				</a>
			</div>
		</div>

		<div class="relative z-10">
			<div class="overflow-hidden rounded-[1.75rem] shadow-soft ring-1 ring-lavender/50">
				<img
					src="/assets/images/placeholders/hero-dessert-table.svg"
					alt="Elaborate purple dessert table with a galaxy cake at an upscale Baltimore event"
					class="aspect-4/3 w-full object-cover"
					width="960"
					height="720"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>

	<div class="hero-wave pointer-events-none absolute inset-x-0 bottom-0 leading-0">
		<svg
			viewBox="0 0 1440 96"
			preserveAspectRatio="none"
			class="h-16 w-full text-off-white lg:h-24"
			aria-hidden="true"
		>
			<path
				fill="currentColor"
				d="M0,64 C240,112 480,16 720,40 C960,64 1200,112 1440,48 L1440,96 L0,96 Z"
			></path>
		</svg>
	</div>
</section>
