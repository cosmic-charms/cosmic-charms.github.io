---
import { contact } from '../data/contact';
import { navigation } from '../data/navigation';
import { site } from '../data/site';
import { social } from '../data/social';
import ArrowRight from './icons/ArrowRight.astro';
import Facebook from './icons/Facebook.astro';
import Instagram from './icons/Instagram.astro';
import Pinterest from './icons/Pinterest.astro';
import TikTok from './icons/TikTok.astro';
---

<footer class="footer-section section-navy celestial-night text-lavender">
	<div class="footer mx-auto max-w-[90rem] gap-10 px-6 py-14 sm:footer-horizontal lg:px-10 lg:py-16">
		<aside class="max-w-xs">
			<img
				src="/assets/images/logo.jpg"
				alt={`${site.title} logo`}
				class="h-28 w-28 rounded-full object-cover shadow-soft ring-4 ring-white/80"
				width="112"
				height="112"
			/>
		</aside>

		<nav aria-label="Quick links">
			<h2 class="footer-title font-display text-lg font-semibold tracking-wide text-white opacity-100">Quick Links</h2>
			{
				navigation.map((item) => (
					<a
						href={item.path}
						class="link link-hover text-lavender/90"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<nav aria-label="Contact">
			<h2 class="footer-title font-display text-lg font-semibold tracking-wide text-white opacity-100">Contact</h2>
			<a
				href={`mailto:${contact.email}`}
				class="link link-hover text-lavender/90"
			>
				{contact.email}
			</a>
			<a
				href={contact.phoneHref}
				class="link link-hover text-lavender/90"
			>
				{contact.phone}
			</a>
			<p class="text-lavender/90">{contact.location}</p>
		</nav>

		<nav aria-label="Social media">
			<h2 class="footer-title font-display text-lg font-semibold tracking-wide text-white opacity-100">Follow Us</h2>
			<div class="mt-1 flex flex-wrap gap-3">
				<a
					href={social.instagram}
					class="btn btn-circle border-white/30 bg-white/10 text-white hover:bg-white/20"
					aria-label="Instagram"
					rel="noopener noreferrer"
					target="_blank"
				>
					<Instagram class="h-4 w-4" />
				</a>
				<a
					href={social.facebook}
					class="btn btn-circle border-white/30 bg-white/10 text-white hover:bg-white/20"
					aria-label="Facebook"
					rel="noopener noreferrer"
					target="_blank"
				>
					<Facebook class="h-4 w-4" />
				</a>
				<a
					href={social.tiktok}
					class="btn btn-circle border-white/30 bg-white/10 text-white hover:bg-white/20"
					aria-label="TikTok"
					rel="noopener noreferrer"
					target="_blank"
				>
					<TikTok class="h-4 w-4" />
				</a>
				<a
					href={social.pinterest}
					class="btn btn-circle border-white/30 bg-white/10 text-white hover:bg-white/20"
					aria-label="Pinterest"
					rel="noopener noreferrer"
					target="_blank"
				>
					<Pinterest class="h-4 w-4" />
				</a>
			</div>
		</nav>

		<form
			class="w-full max-w-xs"
			action="#"
			method="post"
		>
			<h2 class="footer-title font-display text-lg font-semibold tracking-wide text-white opacity-100">
				Join the Cosmic Crew
			</h2>
			<p class="mb-4 text-sm leading-relaxed text-lavender/85">
				Get updates on seasonal treats, events, and special offers!
			</p>
			<label
				class="sr-only"
				for="newsletter-email"
			>
				Email address
			</label>
			<div class="join w-full overflow-hidden rounded-full bg-lavender">
				<input
					id="newsletter-email"
					type="email"
					name="email"
					placeholder="Enter your email.."
					class="input join-item input-md grow border-0 bg-transparent text-navy-blue placeholder:text-navy-blue/50 focus:outline-none"
					required
				/>
				<button
					type="submit"
					class="btn join-item btn-circle btn-primary m-1"
					aria-label="Subscribe to newsletter"
				>
					<ArrowRight class="h-4 w-4" />
				</button>
			</div>
		</form>
	</div>

	<div class="border-t border-white/15 px-6 py-5 text-center lg:px-10">
		<p class="text-sm text-lavender/80">
			© 2024 Cosmic Charms Bakery · Baltimore, MD · Made with love & little stardust ✨
		</p>
	</div>
</footer>
