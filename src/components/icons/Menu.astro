---
interface Props {
	class?: string;
}

const { class: className = 'h-6 w-6' } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	<path d="M4 6h16"></path>
	<path d="M4 12h16"></path>
	<path d="M4 18h16"></path>
</svg>
