---
import { testimonials } from '../data/testimonials';
import Sparkle from './icons/Sparkle.astro';
---

<section class="section-dark celestial-night section-spacing relative overflow-hidden">
	<div class="relative mx-auto max-w-[90rem] px-6 lg:px-10">
		<div class="mb-12 flex items-center justify-center gap-4">
			<span class="hidden h-px w-16 bg-white/50 sm:block"></span>
			<Sparkle class="h-4 w-4 text-lavender" />
			<h2 class="font-display text-center text-3xl font-semibold text-white lg:text-4xl">What Clients Are Saying</h2>
			<Sparkle class="h-4 w-4 text-lavender" />
			<span class="hidden h-px w-16 bg-white/50 sm:block"></span>
		</div>

		<div class="grid gap-8 lg:grid-cols-3 lg:gap-6 xl:gap-8">
			{
				testimonials.map((item) => (
					<article class="flex gap-4">
						<img
							src={item.image}
							alt={item.alt}
							class="h-24 w-24 shrink-0 rounded-2xl object-cover shadow-soft ring-1 ring-white/20 lg:h-28 lg:w-28"
							width="112"
							height="112"
							loading="lazy"
						/>
						<div>
							<blockquote class="text-sm leading-relaxed text-white/95 lg:text-[0.95rem]">
								“{item.quote}”
							</blockquote>
							<p class="mt-3 text-sm font-bold text-white">— {item.name}</p>
							<p class="text-sm text-lavender/90">{item.role}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
