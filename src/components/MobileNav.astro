---
import { navigation } from '../data/navigation';

const currentPath = Astro.url.pathname;
---

<div class="drawer-side z-50 lg:hidden">
	<label
		for="mobile-nav"
		class="drawer-overlay"
		aria-label="Close navigation menu"
	></label>
	<nav
		class="flex min-h-full w-72 flex-col bg-base-100 text-base-content shadow-soft"
		aria-label="Mobile"
	>
		<div class="flex items-center justify-between border-b border-lavender/60 px-5 py-4">
			<p class="font-display text-lg font-semibold text-navy-blue">Menu</p>
			<label
				for="mobile-nav"
				class="btn btn-ghost btn-sm btn-circle"
				aria-label="Close navigation menu"
			>
				<span aria-hidden="true">&times;</span>
			</label>
		</div>
		<ul class="menu w-full gap-1 p-4">
			{
				navigation.map((item) => {
					const isHome = item.path === '/' && (currentPath === '/' || currentPath === '');
					const isCurrent = isHome || (item.path !== '/' && currentPath.startsWith(item.path));

					return (
						<li>
							<a
								href={item.path}
								class:list={[
									'font-display rounded-full px-4 py-3 text-base font-medium text-navy-blue',
									isCurrent ? 'bg-soft-lavender text-primary-purple' : 'hover:bg-soft-lavender',
								]}
								aria-current={isCurrent ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</div>
